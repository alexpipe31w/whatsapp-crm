generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum PriceType {
  FIXED
  PER_HOUR
  PER_DAY
  PER_UNIT
  VARIABLE
}

/// Estados del ciclo de vida de una cita
enum AppointmentStatus {
  PENDING      // Recién creada — esperando confirmación
  CONFIRMED    // Confirmada por el negocio
  IN_PROGRESS  // En curso
  COMPLETED    // Finalizada exitosamente
  CANCELLED    // Cancelada (ver cancelReason)
  NO_SHOW      // El cliente no se presentó
  RESCHEDULED  // Reagendada — se crea nueva cita, esta queda como historial
}

/// Prioridad de atención
enum AppointmentPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Quién o qué originó la cita
enum AppointmentSource {
  AI         // Creada automáticamente por el bot de WhatsApp
  MANUAL     // Creada manualmente por el admin desde el dashboard
  WHATSAPP   // Creada por el cliente vía WhatsApp sin IA
  API        // Creada vía integración externa
}

// ─── Store ────────────────────────────────────────────────────────────────────

model Store {
  storeId     String   @id @default(uuid()) @map("store_id")
  name        String   @db.VarChar(100)
  phone       String   @unique @db.VarChar(20)
  ownerName   String?  @map("owner_name") @db.VarChar(100)
  adminPhone  String?  @map("admin_phone") @db.VarChar(20)

  // Información del negocio
  description     String?  @map("description")
  address         String?  @map("address")
  neighborhood    String?  @map("neighborhood")
  directions      String?  @map("directions")
  googleMapsUrl   String?  @map("google_maps_url")

  // Contacto y redes
  email           String?  @map("email")
  website         String?  @map("website")
  instagram       String?  @map("instagram")
  facebook        String?  @map("facebook")
  tiktok          String?  @map("tiktok")

  // Pagos
  paymentMethods  String[] @map("payment_methods")
  paymentAccount  String?  @map("payment_account")
  requiresDeposit Boolean  @default(false) @map("requires_deposit")
  depositAmount   String?  @map("deposit_amount")

  // Políticas
  minAdvanceMinutes  Int?     @map("min_advance_minutes")
  cancellationPolicy String?  @map("cancellation_policy")
  hasDelivery        Boolean  @default(false) @map("has_delivery")
  deliveryZone       String?  @map("delivery_zone")
  hasParking         Boolean  @default(false) @map("has_parking")

  // Datos del cliente que la IA debe pedir/guardar — varían según el tipo de negocio
  // (una barbería no necesita dirección ni cédula; un taller de instalaciones sí).
  // false = la IA nunca pregunta ni extrae ese dato, sin importar lo que diga el cliente.
  requiresCustomerAddress Boolean @default(false) @map("requires_customer_address")
  requiresCustomerCedula  Boolean @default(false) @map("requires_customer_cedula")

  // ── Pedidos de productos (separado de la config de citas de arriba) ──
  // hasDelivery/requiresDeposit/cancellationPolicy/requiresCustomer* son de CITAS;
  // estos son los equivalentes para PEDIDOS. Ver plan 2026-10-06-config-productos-servicios.
  orderShipping        Boolean @default(false) @map("order_shipping")
  orderShippingZone    String? @map("order_shipping_zone")
  orderRequiresDeposit Boolean @default(false) @map("order_requires_deposit")
  orderDepositAmount   String? @map("order_deposit_amount")
  orderPolicy          String? @map("order_policy")
  orderRequiresCedula  Boolean @default(false) @map("order_requires_cedula")

  // Horarios de atención
  businessHours   Json?    @map("business_hours")

  waSessionId String?  @unique @map("wa_session_id") @db.VarChar(50)
  staffLabel  String?  @default("Profesional") @map("staff_label") @db.VarChar(50)
  slug        String?  @unique @map("slug") @db.VarChar(100)
  defaultServiceId String? @map("default_service_id")  // servicio usado cuando el cliente no especifica
  isActive    Boolean  @default(true) @map("is_active")

  // Si está activo, una cita que lleve +15 min en PENDING se autoconfirma sola (y el
  // cliente recibe la confirmación por WhatsApp) sin esperar a que el barbero/admin confirme.
  autoConfirmAppointments Boolean @default(true) @map("auto_confirm_appointments")

  // Paleta de colores personalizable por tienda
  primaryColor   String? @default("#2563eb") @map("primary_color")   @db.VarChar(7)
  secondaryColor String? @default("#9333ea") @map("secondary_color") @db.VarChar(7)
  accentColor    String? @default("#f59e0b") @map("accent_color")    @db.VarChar(7)

  subscriptionStatus String    @default("none") @map("subscription_status") @db.VarChar(20)
  subscriptionEnd    DateTime? @map("subscription_end")
  apiBlocked         Boolean   @default(false) @map("api_blocked")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customers       Customer[]
  conversations   Conversation[]
  messages        Message[]
  products        Product[]
  categories      Category[]
  users           User[]
  services        Service[]
  orders          Order[]
  appointments    Appointment[]
  campaigns       Campaign[]
  aiConfig        AIConfiguration?
  blockedContacts BlockedContact[]
  waSession       WhatsappSession?
  subscription    Subscription?
  dailyReports    DailyReport[]
  staff           Staff[]
  stockupConnection StockupConnection?
  syncOutbox        SyncOutbox[]
  waOutbound        WaOutbound[]
  waInbound         WaInbound[]

  @@map("stores")
}

// ─── Customer ─────────────────────────────────────────────────────────────────

model Customer {
  customerId String   @id @default(uuid()) @map("customer_id")
  storeId    String   @map("store_id")
  // Identidad del cliente. Normalmente el teléfono ("+57300..."), pero si WhatsApp lo
  // direcciona por LID y no entrega el número, es "lid:<user>" — ver waLid.
  phone      String   @db.VarChar(32)
  // LID de WhatsApp cuando se conoce, tanto si además tenemos teléfono como si no.
  // Índice único parcial por tienda `customers_store_wa_lid_key` (WHERE wa_lid IS NOT NULL),
  // creado a mano en la migración 20261010000000_consolidar_migraciones_de_arranque
  // porque Prisma no declara índices parciales.
  // ATENCIÓN: en este repo NUNCA usar `prisma db push` ni `prisma migrate dev` contra una
  // BD con datos: borrarían ese índice. Las migraciones nuevas se generan con
  // `prisma migrate diff ... --script` y se revisan a mano.
  waLid      String?  @map("wa_lid") @db.VarChar(32)
  name       String?  @db.VarChar(100)
  cedula     String?  @db.VarChar(20)
  city       String?  @db.VarChar(100)

  // Métricas de compra
  totalOrders    Int      @default(0) @map("total_orders")
  totalSpent     Decimal  @default(0) @map("total_spent") @db.Decimal(10, 2)
  firstOrderDate DateTime? @map("first_order_date")
  lastOrderDate  DateTime? @map("last_order_date")

  // Segmentación para campañas
  acceptsMarketing Boolean @default(true) @map("accepts_marketing")
  // Último mensaje recibido de este cliente por WhatsApp. Los mensajes se purgan a las
  // 24 h (CleanupService), así que esta columna es la única memoria duradera de "ya
  // nos escribió": decide a quién se le pueden mandar campañas (spec, Baileys) y en el
  // bloque 8 la ventana de 24 h de Cloud API.
  lastInboundAt DateTime? @map("last_inbound_at")

  // Resumen de la última conversación — lo usa la IA como contexto en nuevas charlas
  lastConversationSummary String? @map("last_conversation_summary") @db.Text

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  store         Store          @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  conversations Conversation[]
  orders        Order[]
  appointments  Appointment[]

  @@unique([storeId, phone])
  @@index([storeId, createdAt])
  @@index([storeId, totalSpent])
  @@index([storeId, lastInboundAt])
  @@map("customers")
}

// ─── Conversation ─────────────────────────────────────────────────────────────

model Conversation {
  conversationId String   @id @default(uuid()) @map("conversation_id")
  storeId        String   @map("store_id")
  customerId     String   @map("customer_id")
  status         String   @default("active")
  startedAt      DateTime @default(now()) @map("started_at")
  lastMessageAt  DateTime @default(now()) @map("last_message_at")
  createdAt      DateTime @default(now()) @map("created_at")

  // Fecha en que sus mensajes fueron archivados (cleanup nocturno)
  archivedAt DateTime? @map("archived_at")

  store    Store     @relation(fields: [storeId], references: [storeId])
  customer Customer  @relation(fields: [customerId], references: [customerId])
  messages Message[]

  @@index([storeId, status])
  @@index([customerId, status])
  @@index([storeId, lastMessageAt])
  @@map("conversations")
}

// ─── Message ──────────────────────────────────────────────────────────────────

model Message {
  messageId      String   @id @default(uuid()) @map("message_id")
  conversationId String   @map("conversation_id")
  storeId        String   @map("store_id")
  content        String
  type           String
  sender         String   @default("customer")
  isAiResponse   Boolean  @default(false) @map("is_ai_response")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [conversationId])
  store        Store        @relation(fields: [storeId], references: [storeId])

  @@index([conversationId, createdAt])
  @@index([storeId, createdAt])
  @@map("messages")
}

// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  categoryId String   @id @default(uuid()) @map("category_id")
  storeId    String   @map("store_id")
  name       String   @db.VarChar(100)
  slug       String   @db.VarChar(100)
  stockupCategoryId String? @map("stockup_category_id") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")

  store    Store     @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("categories")
}

// ─── Product ──────────────────────────────────────────────────────────────────

model Product {
  productId    String   @id @default(uuid()) @map("product_id")
  storeId      String   @map("store_id")
  categoryId   String?  @map("category_id")

  sku          String?  @db.VarChar(100)
  name         String   @db.VarChar(200)
  description  String?  @db.Text

  salePrice    Decimal  @map("sale_price")  @db.Decimal(10, 2)
  costPrice    Decimal  @default(0) @map("cost_price") @db.Decimal(10, 2)
  profitMargin Decimal? @map("profit_margin") @db.Decimal(5, 2)

  stock       Int     @default(0)
  hasVariants Boolean @default(false) @map("has_variants")

  imageUrl         String?  @map("image_url") @db.VarChar(500)
  images           String[] @default([])                          // múltiples imágenes
  hasShipping      Boolean  @default(false) @map("has_shipping")
  weight           Decimal? @db.Decimal(8, 3)
  shippingStandard Decimal? @default(0) @map("shipping_standard") @db.Decimal(10, 2)
  shippingExpress  Decimal? @default(0) @map("shipping_express")  @db.Decimal(10, 2)

  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(0)
  stockupProductId String?   @map("stockup_product_id") @db.VarChar(50)
  stockupSyncedAt  DateTime? @map("stockup_synced_at") // occurredAt del último evento StockUp aplicado (orden evento-contra-evento, no updatedAt)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  store      Store            @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  category   Category?        @relation(fields: [categoryId], references: [categoryId])
  orderItems OrderItem[]
  variants   ProductVariant[]

  @@unique([storeId, sku])
  @@index([storeId, isActive])
  @@index([storeId, categoryId])
  @@index([storeId, createdAt])
  @@map("products")
}

// ─── ProductVariant ───────────────────────────────────────────────────────────

model ProductVariant {
  variantId    String   @id @default(uuid()) @map("variant_id")
  productId    String   @map("product_id")

  name         String   @db.VarChar(200)
  sku          String?  @db.VarChar(100)

  salePrice    Decimal? @map("sale_price")  @db.Decimal(10, 2)
  costPrice    Decimal? @default(0) @map("cost_price") @db.Decimal(10, 2)
  profitMargin Decimal? @map("profit_margin") @db.Decimal(5, 2)

  stock      Int     @default(0)
  attributes Json    @default("{}")
  imageUrl   String? @map("image_url") @db.VarChar(500)
  weight     Decimal? @db.Decimal(8, 3)

  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0)    @map("sort_order")
  stockupVariantId String?   @map("stockup_variant_id") @db.VarChar(50)
  stockupSyncedAt  DateTime? @map("stockup_synced_at") // occurredAt del último evento StockUp aplicado (orden evento-contra-evento, no updatedAt)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  product    Product     @relation(fields: [productId], references: [productId], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId, isActive])
  @@index([productId])
  @@map("product_variants")
}

// ─── Service ──────────────────────────────────────────────────────────────────

model Service {
  serviceId   String    @id @default(uuid()) @map("service_id")
  storeId     String    @map("store_id")

  name        String    @db.VarChar(200)
  description String?   @db.Text
  category    String?   @db.VarChar(100)
  imageUrl    String?   @map("image_url") @db.VarChar(500)

  priceType PriceType @default(FIXED) @map("price_type")
  basePrice Decimal?  @map("base_price") @db.Decimal(10, 2)
  minPrice  Decimal?  @map("min_price")  @db.Decimal(10, 2)
  maxPrice  Decimal?  @map("max_price")  @db.Decimal(10, 2)
  costPrice Decimal?  @map("cost_price") @db.Decimal(10, 2)
  unitLabel String?   @map("unit_label") @db.VarChar(50)

  hasVariants      Boolean @default(false) @map("has_variants")
  estimatedMinutes Int?    @map("estimated_minutes")
  customFields     Json?   @default("{}") @map("custom_fields")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  store        Store            @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  variants     ServiceVariant[]
  orderItems   OrderItem[]
  appointments Appointment[]

  @@index([storeId, isActive])
  @@index([storeId, priceType])
  @@map("services")
}

// ─── ServiceVariant ───────────────────────────────────────────────────────────

model ServiceVariant {
  variantId   String   @id @default(uuid()) @map("variant_id")
  serviceId   String   @map("service_id")

  name        String   @db.VarChar(200)
  description String?  @db.Text

  priceOverride    Decimal? @map("price_override") @db.Decimal(10, 2)
  priceModifier    Decimal? @map("price_modifier") @db.Decimal(5, 2)
  estimatedMinutes Int?     @map("estimated_minutes")

  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0)    @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  service      Service       @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)
  orderItems   OrderItem[]
  appointments Appointment[]

  @@index([serviceId, isActive])
  @@index([serviceId])
  @@map("service_variants")
}

// ─── Order ────────────────────────────────────────────────────────────────────

model Order {
  orderId         String   @id @default(uuid()) @map("order_id")
  storeId         String   @map("store_id")
  customerId      String   @map("customer_id")
  type            String   @default("product")
  total           Decimal  @default(0) @db.Decimal(10, 2)
  subtotal        Decimal  @default(0) @db.Decimal(10, 2)         // total antes de descuento
  discountPercent Decimal? @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  status          String   @default("pending")
  notes           String?  @db.Text
  estimatedTime   Int?     @map("estimated_time")
  deliveryAddress String?  @map("delivery_address")

  // Venta manual registrada por el admin
  isManual            Boolean @default(false) @map("is_manual")
  manualPaymentMethod String? @map("manual_payment_method") @db.VarChar(50) // CASH | TRANSFER | CARD | OTHER

  // Idempotencia — evita órdenes duplicadas
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(100)

  // Vínculo opcional a cita (para órdenes de servicio generadas automáticamente)
  appointmentId String? @unique @map("appointment_id") @db.VarChar(36)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  store      Store       @relation(fields: [storeId], references: [storeId])
  customer   Customer    @relation(fields: [customerId], references: [customerId])
  orderItems OrderItem[]

  @@index([storeId, status])
  @@index([storeId, type])
  @@index([storeId, createdAt])
  @@map("orders")
}

// ─── OrderItem ────────────────────────────────────────────────────────────────

model OrderItem {
  itemId           String  @id @default(uuid()) @map("item_id")
  orderId          String  @map("order_id")
  productId        String? @map("product_id")
  variantId        String? @map("variant_id")
  serviceId        String? @map("service_id")
  serviceVariantId String? @map("service_variant_id")
  description      String? @db.VarChar(500)
  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(10, 2)

  order          Order           @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [productId])
  variant        ProductVariant? @relation(fields: [variantId], references: [variantId])
  service        Service?        @relation(fields: [serviceId], references: [serviceId])
  serviceVariant ServiceVariant? @relation(fields: [serviceVariantId], references: [variantId])

  @@index([orderId])
  @@index([productId])
  @@index([serviceId])
  @@map("order_items")
}

// ─── Appointment ──────────────────────────────────────────────────────────────

/// Cita o agendamiento de servicio.
///
/// Flujo de estados:
///   PENDING → CONFIRMED → IN_PROGRESS → COMPLETED
///   PENDING → CANCELLED
///   CONFIRMED → CANCELLED | NO_SHOW | RESCHEDULED
///
/// Vinculación al catálogo (opcional):
///   Si la cita corresponde a un servicio registrado, se vincula vía
///   serviceId / serviceVariantId para tener contexto de precio y duración.
///   Si no, description explica libremente qué se va a hacer.
///
/// Fuentes:
///   - AI: el bot de WhatsApp extrae los datos y crea la cita automáticamente
///   - MANUAL: el admin la crea desde el dashboard
///   - WHATSAPP: el cliente coordina vía chat sin que la IA tome los datos
model Appointment {
  appointmentId String @id @default(uuid()) @map("appointment_id")
  storeId       String @map("store_id")
  customerId    String @map("customer_id")

  // ── Vínculo al catálogo (opcional) ────────────────────────────────────────
  serviceId        String? @map("service_id")
  serviceVariantId String? @map("service_variant_id")
  staffId          String? @map("staff_id")

  // ── Clasificación ─────────────────────────────────────────────────────────
  // type: texto libre que describe el tipo cuando no hay servicio vinculado.
  // Ej: "visita_tecnica", "consulta", "corte", "instalacion", "mantenimiento"
  type     String              @default("cita") @db.VarChar(100)
  status   AppointmentStatus   @default(PENDING)
  priority AppointmentPriority @default(NORMAL)
  source   AppointmentSource   @default(MANUAL)

  // ── Tiempo ────────────────────────────────────────────────────────────────
  scheduledAt     DateTime  @map("scheduled_at")       // Inicio de la cita
  endsAt          DateTime? @map("ends_at")             // Fin (scheduledAt + durationMinutes)
  durationMinutes Int?      @map("duration_minutes")    // Duración estimada en minutos

  // ── Contenido ─────────────────────────────────────────────────────────────
  description   String? @db.Text // Qué se va a hacer — visible para cliente y admin
  address       String? @db.Text // Dirección si es visita a domicilio
  notes         String? @db.Text // Notas del cliente / visibles al cliente
  internalNotes String? @db.Text @map("internal_notes") // Solo admin — NO visible al cliente

  // ── Precio acordado ───────────────────────────────────────────────────────
  // Snapshot del precio al momento de agendar.
  // Independiente de cambios futuros en el catálogo.
  agreedPrice Decimal? @map("agreed_price") @db.Decimal(10, 2)

  // ── Timestamps del ciclo de vida ──────────────────────────────────────────
  confirmedAt  DateTime? @map("confirmed_at")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @db.VarChar(500) @map("cancel_reason")

  // ── Recordatorios granulares ──────────────────────────────────────────────
  reminderSentAt   DateTime? @map("reminder_sent_at")   // legacy — keep for compat
  reminder8hSentAt DateTime? @map("reminder_8h_sent_at")
  reminder2hSentAt DateTime? @map("reminder_2h_sent_at")
  reminder1hSentAt DateTime? @map("reminder_1h_sent_at")

  // ── Pagos ─────────────────────────────────────────────────────────────────
  paymentStatus      String    @default("PENDING") @map("payment_status") @db.VarChar(20)
  paymentMethod      String?   @map("payment_method")  @db.VarChar(50)
  paymentAmount      Decimal?  @map("payment_amount")  @db.Decimal(10, 2)
  paymentProofUrl    String?   @map("payment_proof_url") @db.Text
  paymentNotes       String?   @map("payment_notes")   @db.Text
  paymentConfirmedAt DateTime? @map("payment_confirmed_at")

  // ── Acciones pendientes (cancelar/reprogramar esperando aprobación) ────────
  pendingAction       String?   @map("pending_action")        @db.VarChar(50)
  pendingActionAt     DateTime? @map("pending_action_at")
  pendingActionData   Json?     @map("pending_action_data")
  pendingActionReason String?   @map("pending_action_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  store          Store                 @relation(fields: [storeId], references: [storeId])
  customer       Customer              @relation(fields: [customerId], references: [customerId])
  service        Service?              @relation(fields: [serviceId], references: [serviceId])
  serviceVariant ServiceVariant?       @relation(fields: [serviceVariantId], references: [variantId])
  staff          Staff?                @relation(fields: [staffId], references: [staffId])
  timeline       AppointmentTimeline[]

  @@index([storeId, scheduledAt])
  @@index([storeId, status])
  @@index([storeId, status, scheduledAt])
  @@index([customerId])
  @@index([serviceId])
  @@index([storeId, createdAt])
  @@index([storeId, staffId, scheduledAt])
  @@map("appointments")
}

// ─── AppointmentTimeline ──────────────────────────────────────────────────────

/// Historial inmutable de todos los cambios de una cita.
/// Sirve para auditoría, soporte y trazabilidad completa.
/// isPublic = true  → el cliente puede verlo en su seguimiento
/// isPublic = false → solo visible para el admin
model AppointmentTimeline {
  timelineId    String @id @default(uuid()) @map("timeline_id")
  appointmentId String @map("appointment_id")

  // Acción que disparó este registro:
  // CREATED | CONFIRMED | IN_PROGRESS | COMPLETED | CANCELLED |
  // NO_SHOW | RESCHEDULED | NOTE_ADDED | REMINDER_SENT | UPDATED
  action String @db.VarChar(100)

  previousStatus AppointmentStatus? @map("previous_status")
  newStatus      AppointmentStatus? @map("new_status")

  note     String?  @db.Text      // Descripción legible del cambio
  isPublic Boolean  @default(true) @map("is_public")

  // null = cambio automático del sistema o IA
  // uuid = userId del admin que hizo el cambio
  performedById String? @map("performed_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [appointmentId], onDelete: Cascade)

  @@index([appointmentId])
  @@index([appointmentId, createdAt])
  @@map("appointment_timelines")
}

// ─── DailyReport ─────────────────────────────────────────────────────────────

model DailyReport {
  reportId         String   @id @default(uuid()) @map("report_id")
  storeId          String   @map("store_id")
  date             DateTime @db.Date @map("date")
  appointmentsData Json     @map("appointments_data")
  paymentsData     Json     @map("payments_data")
  clientsData      Json     @map("clients_data")
  createdAt        DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [storeId])

  @@unique([storeId, date])
  @@map("daily_reports")
}

// ─── AIConfiguration ─────────────────────────────────────────────────────────

model AIConfiguration {
  configId     String  @id @default(uuid()) @map("config_id")
  storeId      String  @unique @map("store_id")
  aiProvider   String  @default("groq") @map("ai_provider")
  apiKey       String  @map("groq_api_key")
  systemPrompt String  @map("system_prompt")
  model        String  @default("openai/gpt-oss-120b")
  temperature  Decimal @default(0.70) @db.Decimal(3, 2)
  // Los modelos de razonamiento (gpt-oss) gastan de este mismo presupuesto al pensar:
  // con 600 la respuesta al cliente salía cortada a media frase.
  maxTokens    Int     @default(2000) @map("max_tokens")
  settings     Json    @default("{}")
  cartridges   Json?   @map("cartridges")

  store Store @relation(fields: [storeId], references: [storeId])

  @@map("ai_configurations")
}

// ─── Campaign ─────────────────────────────────────────────────────────────────

model Campaign {
  campaignId  String    @id @default(uuid()) @map("campaign_id")
  storeId     String    @map("store_id")
  name        String    @db.VarChar(200)
  message     String
  status      String    @default("draft")
  sentCount   Int       @default(0) @map("sent_count")
  scheduledAt DateTime? @map("scheduled_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [storeId])

  @@map("campaigns")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  userId    String   @id @default(uuid()) @map("user_id")
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(200)
  password  String
  role      String   @default("admin")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  storeId   String?  @map("store_id")

  store Store? @relation(fields: [storeId], references: [storeId])

  @@map("users")
}

// ─── BlockedContact ───────────────────────────────────────────────────────────

model BlockedContact {
  blockedId String   @id @default(uuid()) @map("blocked_id")
  storeId   String   @map("store_id")
  phone     String   @db.VarChar(20)
  label     String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([storeId, phone])
  @@map("blocked_contacts")
}

// ─── ArchivedMessage ──────────────────────────────────────────────────────────
// Conversaciones cerradas > 6 meses se mueven aquí para mantener messages liviana.
// El archivado lo hace un cron mensual vía script de migración.

model ArchivedMessage {
  messageId      String   @id @map("message_id")
  conversationId String   @map("conversation_id")
  storeId        String   @map("store_id")
  content        String
  type           String
  sender         String
  isAiResponse   Boolean  @map("is_ai_response")
  createdAt      DateTime @map("created_at")
  archivedAt     DateTime @default(now()) @map("archived_at")

  @@index([storeId, createdAt])
  @@index([conversationId])
  @@map("archived_messages")
}

// ─── AdminAuditLog ────────────────────────────────────────────────────────────

model AdminAuditLog {
  logId      String   @id @default(uuid()) @map("log_id")
  adminId    String   @map("admin_id")
  action     String   @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(50)
  targetId   String   @map("target_id")
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

// ─── WhatsappSession ─────────────────────────────────────────────────────────

model WhatsappSession {
  storeId   String   @id @map("store_id")
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@map("whatsapp_sessions")
}

// ─── SubscriptionConfig ────────────────────────────────────────────────────────
model SubscriptionConfig {
  configId    String   @id @default("singleton")
  priceAmount Decimal  @map("price_amount") @db.Decimal(10, 2)
  currency    String   @default("COP") @db.VarChar(10)
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by") @db.VarChar(100)

  @@map("subscription_config")
}

// ─── Subscription ──────────────────────────────────────────────────────────────
model Subscription {
  subscriptionId     String    @id @default(uuid()) @map("subscription_id")
  storeId            String    @unique @map("store_id")
  status             String    @default("pending") @db.VarChar(20)
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  priceAmount        Decimal   @map("price_amount") @db.Decimal(10, 2)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  store    Store                 @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  payments SubscriptionPayment[]

  @@map("subscriptions")
}

// ─── SubscriptionPayment ───────────────────────────────────────────────────────
model SubscriptionPayment {
  paymentId      String    @id @default(uuid()) @map("payment_id")
  subscriptionId String    @map("subscription_id")
  mpPaymentId    String?   @unique @map("mp_payment_id") @db.VarChar(100)
  amount         Decimal   @db.Decimal(10, 2)
  status         String    @db.VarChar(20)
  paidAt         DateTime? @map("paid_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [subscriptionId], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_payments")
}

// ─── Staff ────────────────────────────────────────────────────────────────────

model Staff {
  staffId   String   @id @default(uuid()) @map("staff_id")
  storeId   String   @map("store_id")
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")

  // null = hereda store.businessHours
  // Shape: { mon: { isOpen, shift1, shift2 }, tue: ..., ... }
  schedule             Json?  @map("schedule")

  commissionPercentage Float? @map("commission_percentage")

  suspendedFrom        DateTime? @map("suspended_from")
  suspendedUntil       DateTime? @map("suspended_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  store        Store         @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  appointments Appointment[]

  @@index([storeId, isActive])
  @@map("staff")
}

// ─── StockupConnection ────────────────────────────────────────────────────────

model StockupConnection {
  connectionId    String    @id @default(uuid()) @map("connection_id")
  storeId         String    @unique @map("store_id")
  stockupTenantId String?   @map("stockup_tenant_id") @db.VarChar(50)
  secret          String?   @db.VarChar(200)
  enabled         Boolean   @default(false)
  linkCode        String?   @map("link_code") @db.VarChar(20)
  linkCodeExpiresAt DateTime? @map("link_code_expires_at")
  lastSyncAt      DateTime? @map("last_sync_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@map("stockup_connections")
}

// ─── SyncOutbox ───────────────────────────────────────────────────────────────

model SyncOutbox {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  eventId     String   @unique @map("event_id")
  type        String   @db.VarChar(40)
  payload     Json
  status      String   @default("PENDING") @db.VarChar(20)
  attempts    Int      @default(0)
  nextRetryAt DateTime @default(now()) @map("next_retry_at")
  occurredAt  DateTime @default(now()) @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@index([status, nextRetryAt], map: "sync_outbox_status_retry")
  @@map("sync_outbox")
}

// ─── SyncInbox ────────────────────────────────────────────────────────────────

model SyncInbox {
  eventId     String   @id @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("sync_inbox")
}

// ─── Cola de salida de WhatsApp (bloque 1a) ───────────────────────────────────
// Todo envío por WhatsApp pasa por aquí. idempotency_key UNIQUE = nunca dos veces.
// Índice único PARCIAL `wa_outbound_one_sending_per_store` (WHERE status='sending'),
// creado a mano en la migración 20261010000002: Prisma no declara índices parciales.
// NUNCA `prisma db push` / `migrate dev` / `migrate reset`: lo borrarían.
model WaOutbound {
  id                 String    @id @default(uuid())
  storeId            String    @map("store_id")
  toJid              String    @map("to_jid") @db.VarChar(64)
  payload            Json
  kind               String    @db.VarChar(16)
  priority           Int
  idempotencyKey     String    @unique @map("idempotency_key") @db.VarChar(200)
  groupKey           String?   @map("group_key") @db.VarChar(120)
  notBefore          DateTime  @default(now()) @map("not_before")
  expiresAt          DateTime? @map("expires_at")
  status             String    @default("pending") @db.VarChar(16)
  attempts           Int       @default(0)
  lastError          String?   @map("last_error") @db.VarChar(500)
  claimToken         String?   @map("claim_token") @db.VarChar(64)
  lockedUntil        DateTime? @map("locked_until")
  providerMessageIds String[]  @default([]) @map("provider_message_ids")
  deliveryStatus     String?   @map("delivery_status") @db.VarChar(16)
  sentAt             DateTime? @map("sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@index([status, notBefore, priority])
  @@index([storeId, status])
  @@index([groupKey, status])
  @@map("wa_outbound")
}

// ─── Dedupe de entrada de WhatsApp (bloque 1a, mínima) ────────────────────────
// Ids de mensajes ya vistos por tienda. En el bloque 1c se amplía (payload, estado,
// reclamo) añadiendo columnas con DEFAULT, sin renombrar.
model WaInbound {
  id                String   @id @default(uuid())
  storeId           String   @map("store_id")
  providerMessageId String   @map("provider_message_id") @db.VarChar(128)
  createdAt         DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([storeId, providerMessageId])
  @@index([createdAt])
  @@map("wa_inbound")
}
